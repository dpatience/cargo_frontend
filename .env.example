# Base URL of the Tembera Cargo backend API (no trailing slash)
VITE_API_BASE_URL=https://api.cargo.tembera.rw/v1
# Optional realtime endpoint (WebSocket/SSE) — phase 2
VITE_REALTIME_URL=
# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000
# Which app a deployment serves: client | driver | admin. Leave empty to decide by hostname
# (driver.* → Driver, admin.* → Admin, VITE_CLIENT_HOST → Client, anything else → all apps).
VITE_APP=
# Your client domain, e.g. cargo.tembera.rw
VITE_CLIENT_HOST=cargo.tembera.rw
# Public client website URL used for canonical and social metadata
VITE_PUBLIC_SITE_URL=https://cargo.tembera.rw
